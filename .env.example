# Copy this file to ".env" (never commit .env). Settings are read by config.py.

# development or production. Use development on your own PC.
APP_ENV=development

# REQUIRED. Leave empty here; the README shows a command that fills it with a random value.
# The app refuses to start if this is empty or shorter than 32 characters.
SECRET_KEY=

# Optional. Leave empty to use instance/portal.sqlite3
DATABASE_PATH=

# Optional. Set to 1 only if you want Flask's debugger in development. Always 0 for testing the app.
ENABLE_DEBUG=0
